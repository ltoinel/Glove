# Glove frontend (portal) image.
# Builds the React SPA with Vite and serves it with nginx, proxying /api to the
# backend container. This keeps the frontend a separate process from the API.
#
# Base images are pinned by digest (tag kept for readability): a rebuild gets
# exactly the layers that were reviewed, and Dependabot bumps both together.

# Stage 1: Build the SPA

# 22+ is required by swagger-client, pulled in by swagger-ui-react.
FROM node:25-alpine@sha256:bdf2cca6fe3dabd014ea60163eca3f0f7015fbd5c7ee1b0e9ccb4ced6eb02ef4 AS build
WORKDIR /app/portal
COPY portal/package.json portal/package-lock.json ./
RUN npm ci --silent
COPY portal/ ./
RUN npx vite build --outDir /app/portal-dist --emptyOutDir

# Stage 2: Serve with nginx, as the unprivileged `nginx` user (uid 101) — the
# master process included, hence port 8080 instead of 80.
FROM nginxinc/nginx-unprivileged:1.31-alpine@sha256:26b0bf6fbf07297983cb341998d79c831508787de26627dd2a112321b9c3a4af
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/portal-dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1
