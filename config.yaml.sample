# Glove configuration

server:
  bind: "0.0.0.0"
  port: 8080
  workers: 0                    # 0 = auto (one per logical CPU)
  log_level: "warn"             # trace, debug, info, warn, error
  shutdown_timeout: 30          # seconds — graceful shutdown for in-flight requests
  api_key: "glove"               # Required for POST /api/gtfs/reload and disruption writes. Empty = disabled
  cors_origins:                 # Allowed origins. ["*"] = permissive (not for production)
    - "https://portal.glove"    # portal served by Caddy (bin/start.sh); keep in sync with GLOVE_PORTAL_HOST
  rate_limit: 0                 # Max requests/sec per IP. 0 = disabled

data:
  dir: "data"                   # sub-dirs gtfs/, osm/, raptor/, ban/, disruptions/ are implicit
  gtfs_url: "https://data.iledefrance-mobilites.fr/explore/dataset/offre-horaires-tc-gtfs-idfm/files/a925e164271e4bca93433756d6a340d1/download/"
  osm_url: "https://download.geofabrik.de/europe/france/ile-de-france-latest.osm.pbf"
  ban_url: "https://adresse.data.gouv.fr/data/ban/adresses/latest/csv"
  departments: [75, 77, 78, 91, 92, 93, 94, 95]

routing:
  max_journeys: 5
  max_transfers: 4
  default_transfer_time: 120    # seconds
  rail_change_time: 300         # seconds — train/RER/metro to train/RER/metro at one stop
  max_duration: 10800           # 3 hours in seconds
  service_day_start: 14400      # seconds after midnight (04:00); earlier queries use the previous day's services
  max_nearest_stop_distance: 1500  # meters (~20 min walk at 5 km/h)
  fallback_stop_distance: 2500  # meters — second search when an address finds nothing
  walk_matrix_stops: 30         # nearest stops whose walk from an address is timed by Valhalla
  diverse_lines: false          # true = each alternative departs on a different line (line-level diversity)
  prefer_rail: true            # true = rail/metro/tram/train found first; bus only fills remaining slots
  prefer_rail_max_walk: 600     # seconds — prefer_rail only when a rail stop is this close to both ends
  maneuvers: false             # true = include turn-by-turn directions (server-controlled, not per-request)

valhalla:
  host: "localhost"
  port: 8002
  pedestrian_timeout_secs: 5    # per walk matrix / first-last-mile leg during a transit search

pedestrian:                     # default walker (wheelchair below replaces it when requested)
  walking_speed: 5.0            # km/h when the request gives none
  step_penalty: 30              # seconds per flight of stairs (luggage, pushchair)
  elevator_penalty: 60          # seconds for taking an elevator

traffic:                        # Real-time road traffic overlay (Sytadin / DiRIF)
  enabled: true                # true = load segment geometry + poll live states/events
  base_url: "https://www.sytadin.fr/diffusion"  # diffusion feed root (no trailing slash)
  refresh_secs: 600             # dynamic-data refresh interval (feed updates ~1 min)
  # Data © Ministère chargé des transports / DiRIF — Sytadin®, subject to usage
  # conditions. Geometry (Segment.mif/.mid) is loaded from data/sytadin/.

realtime:                       # Real-time transit data (delays, cancellations)
  enabled: false                # true = poll the feeds below and route on real times
  feeds:
    # - name: "idfm-trip-updates"
    #   type: gtfs-rt           # gtfs-rt (SIRI connector to follow)
    #   url: "https://prim.iledefrance-mobilites.fr/marketplace/gtfs-rt"
    #   refresh_secs: 30        # polling interval
    #   timeout_secs: 10        # per-request timeout; keep below refresh_secs
    #   headers:                # provider credentials, sent on every request
    #     apikey: "YOUR_KEY"
  # Feeds are merged in order: on conflict, the last one wins. Health and
  # schedule-matching counters are exposed by GET /api/realtime/status — check
  # them after adding a feed, since a feed can answer 200 and still match
  # nothing when its identifiers use a different namespace than the GTFS.

map:
  zoom: 11
  center_lat: 48.8566
  center_lon: 2.3522
  bounds_sw_lat: 48.1          # South-west corner (Île-de-France)
  bounds_sw_lon: 1.4
  bounds_ne_lat: 49.3          # North-east corner
  bounds_ne_lon: 3.6
  tile_url: "https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"
  # Keyed provider: put {key} in tile_url, e.g.
  # "https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key={key}"
  tile_api_key: ""               # prefer GLOVE_TILE_API_KEY; stays server-side
  tile_cache_duration: 864000    # seconds — browser cache duration for map tiles

wheelchair:
  step_penalty: 999999          # effectively avoid stairs
  max_grade: 6                  # 6% slope max (wheelchair norms)
  use_hills: 0.0                # avoid hills entirely
  elevator_penalty: 0           # prefer elevators
  walking_speed: 3.5            # km/h — typical wheelchair speed

bike:
  city:                         # City bike (Velib' mécanique)
    cycling_speed: 16.0         # km/h — realistic in dense urban areas
    use_roads: 0.2              # prefer bike lanes
    use_hills: 0.3              # avoid climbs
    bicycle_type: "City"

  ebike:                        # E-bike (VAE / Velib' électrique)
    cycling_speed: 21.0         # km/h — motor cuts at 25, avg ~21
    use_roads: 0.4              # accept sharing roads for speed
    use_hills: 0.8              # climbs are easy with motor assist
    bicycle_type: "Hybrid"

  road:                         # Road bike (fast commuter)
    cycling_speed: 25.0         # km/h — cruising speed on good roads
    use_roads: 0.6              # prefer smooth tarmac
    use_hills: 0.5              # effort accepted but not sought
    bicycle_type: "Road"
